<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Craftcms Test | Knecht</title>
  <link rel="stylesheet" href="https://knecht.works/styleguide/kit.css">
  <script src="https://knecht.works/styleguide/kit.js" defer></script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="robots" content="noindex,follow" />
  <script>
    (function () {
      var stored = localStorage.getItem('theme');
      var isLight = stored ? stored === 'light' : !window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('kit-light', isLight);
    })();
  </script>
  {{ craft.vite.script('src/js/app.js', false) }}
</head>
<body class="kit-body">
  <main class="kit-container">
    {% block main %}
      {% block navigation %}
        {%- set localizedEntries = entry.localized.eagerly().all()|index('site.id') -%}

        <div class="flex items-center justify-between">
          <a href="{{ currentSite.baseUrl }}" class="flex items-center text-black!">
            <img class="h-10" src="https://knecht.works/styleguide/assets/knecht-head.svg" alt="Knecht">
            <span class="font-bold text-xl text-current">Knecht</span>
          </a>
          <nav class="flex gap-6 items-center font-bold">
            {% for navEntry in craft.entries.all() %}
              <a href="{{ navEntry.getUrl() }}" class="text-black!">
                {{ navEntry.title }}
              </a>
            {% endfor %}
            <a href="https://knecht.works" target="_blank" class="text-black!">
              Knecht
            </a>
            <label for="language-switcher" class="sr-only">{{ 'Language'|t }}</label>
            <select id="language-switcher" class="cursor-pointer" aria-label="{{ 'Language'|t }}" onchange="window.location.href = this.value">
              {%- for site in craft.app.sites.allSites -%}
                {%- if site.enabled -%}
                  {%- set localizedEntry = localizedEntries[site.id] ?? null -%}
                  {%- set url = localizedEntry ? localizedEntry.url : site.baseUrl -%}
                  <option value="{{ url }}" {% if site.id == currentSite.id %}selected{% endif %}>{{ site.name }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
            <button id="theme-toggle" type="button" class="flex items-center cursor-pointer" style="color: var(--kit-ink)" aria-label="{{ 'Toggle color theme'|t }}">
              <span data-theme-icon="sun" class="w-5 h-5 inline-flex" hidden>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"><path d="M12 3V2m0 20v-1m9-9h1M2 12h1m15.5-6.5L20 4M4 20l1.5-1.5M4 4l1.5 1.5m13 13L20 20" /><circle cx="12" cy="12" r="4" /></svg>
              </span>
              <span data-theme-icon="moon" class="w-5 h-5 inline-flex" hidden>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024" width="20" height="20"><path fill="currentColor" fill-rule="evenodd" d="M489.493 111.658c30.658-1.792 45.991 36.44 22.59 56.329C457.831 214.095 426 281.423 426 354c0 134.757 109.243 244 244 244c72.577 0 139.905-31.832 186.014-86.084c19.868-23.377 58.064-8.102 56.332 22.53C900.4 745.823 725.141 912 512.5 912C291.31 912 112 732.69 112 511.5c0-211.39 164.287-386.024 374.198-399.649l.206-.013zm-81.143 79.75l-4.112 1.362C271.1 237.943 176 364.092 176 511.5C176 697.344 326.656 848 512.5 848c148.28 0 274.938-96.192 319.453-230.41l.625-1.934l-.11.071c-47.18 29.331-102.126 45.755-159.723 46.26L670 662c-170.104 0-308-137.896-308-308c0-58.595 16.476-114.54 46.273-162.467z" /></svg>
              </span>
            </button>
          </nav>
        </div>
      {% endblock navigation %}

      {% llmify %}
      {% block hero %}
        <div class="mt-20">
          <div class="text-center">
            <span class="exclude-llmify kit-badge kit-mb-4">craftcms-test-e2e</span>

            <h1>{{ entry.headline ?? entry.title }}</h1>

            <p class="kit-muted mt-8">
              {{ entry.introText }}
            </p>
          </div>
          {% if entry.asset.eagerly().one() %}
            <div class="mt-8">
              <img class="rounded-lg overflow-hidden" src="{{ entry.asset.eagerly().one().getUrl() }}">
            </div>
          {% endif %}
        </div>
      {% endblock hero %}

      {% block content %}
        <div class="mt-20">
          {{ entry.content|raw }}
        </div>
      {% endblock content %}

      {% endllmify %}
      {% block footer %}
      {% endblock footer %}
    {% endblock main %}

    {{ craft.insights.trackingScript() }}
  </main>
</body>
</html>
