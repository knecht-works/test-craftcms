<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Craftcms Test | Knecht</title>
  <link rel="stylesheet" href="https://knecht.works/styleguide/kit.css">
  <script src="https://knecht.works/styleguide/kit.js" defer></script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="robots" content="noindex,follow" />
  {{ craft.vite.script('src/js/app.js', false) }}
  <script>
    (function () {
      var saved = null;
      try {
        saved = window.localStorage.getItem('theme');
      } catch (e) {}
      var isLight = saved ? saved === 'light' : window.matchMedia('(prefers-color-scheme: light)').matches;
      if (isLight) {
        document.documentElement.classList.add('kit-light-pref');
      }
    })();
  </script>
</head>
<body class="kit-body">
  <script>
    if (document.documentElement.classList.contains('kit-light-pref')) {
      document.body.classList.add('kit-light');
    }
  </script>
  <main class="kit-container">
    {% block main %}
      {% block navigation %}
        {%- set localizedEntries = entry.localized.eagerly().all()|index('site.id') -%}

        <div class="flex items-center justify-between">
          <a href="{{ currentSite.baseUrl }}" class="flex items-center text-black!">
            <img class="h-10" src="https://knecht.works/styleguide/assets/knecht-head.svg" alt="Knecht">
            <span class="font-bold text-xl text-current">Knecht</span>
          </a>
          <nav class="flex gap-6 items-center font-bold">
            {% for navEntry in craft.entries.all() %}
              <a href="{{ navEntry.getUrl() }}" class="text-black!">
                {{ navEntry.title }}
              </a>
            {% endfor %}
            <a href="https://knecht.works" target="_blank" class="text-black!">
              Knecht
            </a>
            <button type="button" id="theme-toggle" class="cursor-pointer text-black!" aria-label="{{ 'Toggle dark mode'|t }}">
              <span id="theme-toggle-icon" aria-hidden="true">🌙</span>
            </button>
            <label for="language-switcher" class="sr-only">{{ 'Language'|t }}</label>
            <select id="language-switcher" class="cursor-pointer" aria-label="{{ 'Language'|t }}" onchange="window.location.href = this.value">
              {%- for site in craft.app.sites.allSites -%}
                {%- if site.enabled -%}
                  {%- set localizedEntry = localizedEntries[site.id] ?? null -%}
                  {%- set url = localizedEntry ? localizedEntry.url : site.baseUrl -%}
                  <option value="{{ url }}" {% if site.id == currentSite.id %}selected{% endif %}>{{ site.name }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </nav>
        </div>
      {% endblock navigation %}

      {% llmify %}
      {% block hero %}
        <div class="mt-20">
          <div class="text-center">
            <span class="exclude-llmify kit-badge kit-mb-4">craftcms-test-e2e</span>

            <h1>{{ entry.headline ?? entry.title }}</h1>

            <p class="kit-muted mt-8">
              {{ entry.introText }}
            </p>
          </div>
          {% if entry.asset.eagerly().one() %}
            <div class="mt-8">
              <img class="rounded-lg overflow-hidden" src="{{ entry.asset.eagerly().one().getUrl() }}">
            </div>
          {% endif %}
        </div>
      {% endblock hero %}

      {% block content %}
        <div class="mt-20">
          {{ entry.content|raw }}
        </div>
      {% endblock content %}

      {% endllmify %}
      {% block footer %}
      {% endblock footer %}
    {% endblock main %}

    {{ craft.insights.trackingScript() }}
  </main>

  <script>
    (function () {
      var toggle = document.getElementById('theme-toggle');
      var icon = document.getElementById('theme-toggle-icon');
      var mediaQuery = window.matchMedia('(prefers-color-scheme: light)');

      function updateIcon() {
        var isLight = document.body.classList.contains('kit-light');
        icon.textContent = isLight ? '☀️' : '🌙';
      }

      updateIcon();

      toggle.addEventListener('click', function () {
        var theme = window.KnechtKit.toggleTheme();
        try {
          window.localStorage.setItem('theme', theme);
        } catch (e) {}
        updateIcon();
      });

      mediaQuery.addEventListener('change', function (event) {
        var saved = null;
        try {
          saved = window.localStorage.getItem('theme');
        } catch (e) {}
        if (saved) {
          return;
        }
        window.KnechtKit.toggleTheme(event.matches);
        updateIcon();
      });
    })();
  </script>
</body>
</html>
