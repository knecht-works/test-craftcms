<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Craftcms Test | Knecht</title>
  <script>
    (function () {
      var theme = localStorage.getItem('theme');
      if (!theme) {
        theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      if (theme === 'light') {
        document.documentElement.classList.add('kit-light');
      }
    })();
  </script>
  <link rel="stylesheet" href="https://knecht.works/styleguide/kit.css">
  <script src="https://knecht.works/styleguide/kit.js" defer></script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="robots" content="noindex,follow" />
  {{ craft.vite.script('src/js/app.js', false) }}
</head>
<body class="kit-body">
  <main class="kit-container">
    {% block main %}
      {% block navigation %}
        {%- set localizedEntries = entry.localized.eagerly().all()|index('site.id') -%}

        <div class="flex items-center justify-between">
          <a href="{{ currentSite.baseUrl }}" class="flex items-center" style="color: var(--kit-ink)">
            <img class="h-10" src="https://knecht.works/styleguide/assets/knecht-head.svg" alt="Knecht">
            <span class="font-bold text-xl text-current">Knecht</span>
          </a>
          <nav class="flex gap-6 items-center font-bold">
            {% for navEntry in craft.entries.all() %}
              <a href="{{ navEntry.getUrl() }}" style="color: var(--kit-ink)">
                {{ navEntry.title }}
              </a>
            {% endfor %}
            <a href="https://knecht.works" target="_blank" style="color: var(--kit-ink)">
              Knecht
            </a>
            <button id="theme-toggle" type="button" class="cursor-pointer" aria-label="Toggle theme" style="color: var(--kit-ink)">
              <span data-theme-icon="sun" hidden>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
              </span>
              <span data-theme-icon="moon" hidden>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
              </span>
            </button>
            <label for="language-switcher" class="sr-only">{{ 'Language'|t }}</label>
            <select id="language-switcher" class="cursor-pointer" aria-label="{{ 'Language'|t }}" onchange="window.location.href = this.value">
              {%- for site in craft.app.sites.allSites -%}
                {%- if site.enabled -%}
                  {%- set localizedEntry = localizedEntries[site.id] ?? null -%}
                  {%- set url = localizedEntry ? localizedEntry.url : site.baseUrl -%}
                  <option value="{{ url }}" {% if site.id == currentSite.id %}selected{% endif %}>{{ site.name }}</option>
                {%- endif -%}
              {%- endfor -%}
            </select>
          </nav>
        </div>
      {% endblock navigation %}

      {% llmify %}
      {% block hero %}
        <div class="mt-20">
          <div class="text-center">
            <span class="exclude-llmify kit-badge kit-mb-4">craftcms-test-e2e</span>

            <h1>{{ entry.headline ?? entry.title }}</h1>

            <p class="kit-muted mt-8">
              {{ entry.introText }}
            </p>
          </div>
          {% if entry.asset.eagerly().one() %}
            <div class="mt-8">
              <img class="rounded-lg overflow-hidden" src="{{ entry.asset.eagerly().one().getUrl() }}">
            </div>
          {% endif %}
        </div>
      {% endblock hero %}

      {% block content %}
        <div class="mt-20">
          {{ entry.content|raw }}
        </div>
      {% endblock content %}

      {% endllmify %}
      {% block footer %}
      {% endblock footer %}
    {% endblock main %}

    {{ craft.insights.trackingScript() }}
  </main>
</body>
</html>
